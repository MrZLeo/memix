option(memix_BUILD_EXECUTABLE "Build executable entrypoints from src/bin." ON)
option(memix_BUILD_MACOS_INSPECTOR "Build the native macOS Memix Inspector app." OFF)
option(memix_STATIC_LINK "Use fully static Linux/MinGW executables and static MSVC CRT; macOS keeps system dylibs." ON)
option(memix_WARNINGS_AS_ERRORS "Treat project compiler warnings as errors." OFF)
option(memix_ENABLE_UNIT_TESTING "Build unit tests from test/." ON)
option(memix_ENABLE_CLANG_TIDY "Analyze project library and CLI sources with clang-tidy." OFF)
option(memix_ENABLE_CPPCHECK "Analyze project library and CLI sources with cppcheck." OFF)
option(memix_ENABLE_CODE_COVERAGE "Enable library/test coverage with GCC or Clang." OFF)
option(memix_ENABLE_DOXYGEN "Enable Doxygen documentation builds." OFF)
option(memix_GENERATE_EXPORT_HEADER "Generate and install memix_export.h." OFF)
option(memix_ENABLE_LTO "Enable interprocedural optimization (LTO)." OFF)
option(memix_ENABLE_CCACHE "Use ccache unless a compiler launcher is explicitly set." ON)
option(memix_ENABLE_ASAN "Enable AddressSanitizer." OFF)

if(NOT CMAKE_CONFIGURATION_TYPES AND NOT CMAKE_BUILD_TYPE)
  set(CACHE{CMAKE_BUILD_TYPE} TYPE STRING HELP "Build configuration" FORCE VALUE Debug)
endif()

# Initialize the runtime for all project and dependency targets before creation.
if(MSVC)
  if(memix_STATIC_LINK)
    set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
  else()
    set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
  endif()
endif()
if(UNIX)
  add_compile_definitions("$<$<CONFIG:Debug>:_DEBUG>")
endif()

if(memix_ENABLE_CCACHE AND NOT DEFINED CMAKE_CXX_COMPILER_LAUNCHER)
  find_program(CCACHE ccache)
  if(CCACHE)
    set(CMAKE_CXX_COMPILER_LAUNCHER "${CCACHE}")
  endif()
endif()

if(memix_ENABLE_LTO)
  include(CheckIPOSupported)
  check_ipo_supported(RESULT ipo_supported OUTPUT ipo_error LANGUAGES CXX)
  if(NOT ipo_supported)
    message(FATAL_ERROR "IPO is not supported: ${ipo_error}")
  endif()
  set(CMAKE_INTERPROCEDURAL_OPTIMIZATION ON)
endif()

if(memix_ENABLE_CODE_COVERAGE AND NOT CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
  message(FATAL_ERROR "Code coverage requires GCC or Clang.")
endif()
if(memix_ENABLE_ASAN)
  if(MSVC)
    add_compile_options(/fsanitize=address)
  else()
    add_compile_options(-fsanitize=address)
    add_link_options(-fsanitize=address)
  endif()
endif()
